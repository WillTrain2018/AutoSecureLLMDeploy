# =============================================================================
# TechCorp LLM Application - SOLUTION: Optimized Multi-Stage Dockerfile
# =============================================================================
# This is the SOLUTION file demonstrating best practices:
# 1. Multi-stage build to reduce image size
# 2. Layer caching optimization
# 3. Non-root user for security
# 4. Proper .dockerignore usage
# 
# Result: Image size reduced from ~45GB to ~15GB (67% reduction)
# =============================================================================

# ==========================
# STAGE 1: Builder
# ==========================
FROM nvidia/cuda:12.1-devel-ubuntu22.04 AS builder

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install Python and build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /build

# OPTIMIZATION: Copy requirements first for layer caching
# This layer only rebuilds when requirements.txt changes
COPY M1_requirements.txt ./requirements.txt
RUN pip3 install --no-cache-dir --target=/build/deps -r requirements.txt

# ==========================
# STAGE 2: Runtime
# ==========================
FROM nvidia/cuda:12.1-runtime-ubuntu22.04 AS runtime

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/deps \
    MODEL_NAME=llama-3.1-8b \
    MODEL_VERSION=v1.0.0

# Install only runtime Python (no dev tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-distutils \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && ln -s /usr/bin/python3.10 /usr/bin/python

# SECURITY: Create non-root user
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

WORKDIR /app

# Copy installed dependencies from builder
COPY --from=builder /build/deps /app/deps

# OPTIMIZATION: Copy application code last (changes most frequently)
COPY M1_app.py ./app.py

# Set ownership to non-root user
RUN chown -R appuser:appgroup /app

# SECURITY: Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Run the application
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]

# =============================================================================
# SOLUTION NOTES:
# 
# Key optimizations applied:
# 
# 1. MULTI-STAGE BUILD
#    - Builder stage: Has all build tools (gcc, python-dev, etc.)
#    - Runtime stage: Only has runtime dependencies
#    - Result: Much smaller final image
#
# 2. LAYER CACHING
#    - requirements.txt copied BEFORE application code
#    - Dependencies only reinstall when requirements change
#    - Application code changes don't trigger full rebuild
#
# 3. BASE IMAGE SELECTION
#    - Builder: cuda:12.1-devel (includes compilers)
#    - Runtime: cuda:12.1-runtime (minimal CUDA runtime)
#    - Could use even smaller base if GPU not needed
#
# 4. SECURITY
#    - Non-root user (appuser)
#    - Minimal installed packages
#    - No build tools in final image
#
# 5. HEALTH CHECK
#    - Built-in health check for Kubernetes/Docker Swarm
#    - Enables automatic container replacement on failure
#
# BUILD COMMANDS:
#   docker build -f M1_Dockerfile.solution -t techcorp-llm:v1 .
#   docker images techcorp-llm:v1  # Check size
#
# VERIFY:
#   docker run -p 8000:8000 techcorp-llm:v1
#   curl http://localhost:8000/health
# =============================================================================
