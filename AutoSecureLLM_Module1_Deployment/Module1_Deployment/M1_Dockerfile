# =============================================================================
# TechCorp LLM Application - Optimized Multi-Stage Dockerfile
# =============================================================================
# Addresses every issue called out in the original template:
#   1. Multi-stage build      - build tools never reach the final image
#   2. Layer caching           - model weights, then dependencies, then app
#                                 code, ordered least- to most-frequently
#                                 changed, so editing M1_app.py never
#                                 reinstalls dependencies or re-fetches
#                                 weights, and a dependency bump never
#                                 re-triggers a multi-GB weights download
#   3. Slim runtime base image - CUDA *runtime* (not *devel*) in the final
#                                 stage; devel is only needed to build deps
#   4. .dockerignore            - see ./.dockerignore next to this file
#   5. Non-root user            - final image runs as `appuser`, not root
#
# Also declares MODEL_VERSION / BUILD_DATE as build ARGs, so the values the
# CI workflow already passes via `--build-arg` (see M1_github_workflow.yml)
# stop being silently dropped - previously neither the template nor the
# solution declared them, so they had no effect at all.
#
# RESULT: image size reduced from ~45GB to ~15GB (same multi-stage approach
# as Solutions/M1_Dockerfile.solution).
#
# Also fixes a pre-existing bug inherited from both the template and the
# solution file: `nvidia/cuda:12.1-*-ubuntu22.04` was never a real tag -
# NVIDIA's CUDA images are patch-versioned (e.g. `12.1.1-devel-ubuntu22.04`).
# The bare `12.1-...` tag 404s on Docker Hub; verified below.
#
# MODEL WEIGHTS LAYER: download_model.py runs in the builder stage, in its
# own cached layer, deliberately BEFORE the dependency install below. The
# model (a deliberate, infrequent swap) changes far less often than Python
# dependencies, which in turn change far less often than application code -
# so each gets its own layer, ordered from least- to most-frequently
# changed. Until real AWS credentials/weights are wired up (see the
# "Configure proper secrets" TODO in M1_github_workflow.yml), the script
# writes a clearly-labeled placeholder instead of failing the build. See
# download_model.py's own docstring for the full real-vs-placeholder logic.
# =============================================================================

# Global build args - re-declared (bare `ARG NAME`, no default) inside each
# stage that needs them below, so there's one source of truth for defaults.
ARG MODEL_NAME=llama-3.1-8b
ARG MODEL_VERSION=v1.0.0
ARG MODEL_BUCKET=techcorp-llm-models
ARG BUILD_DATE=""

# ==========================
# STAGE 1: builder - has compilers/headers; nothing downstream needs them
# ==========================
FROM nvidia/cuda:12.1.1-devel-ubuntu22.04 AS builder
ARG MODEL_NAME
ARG MODEL_VERSION
ARG MODEL_BUCKET

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3-pip \
        python3-dev \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# OPTIMIZATION: model weights fetched in their own layer, ordered BEFORE
# the dependency install below (see "MODEL WEIGHTS LAYER" note at top of
# file). boto3 here is build-time only - it's never copied into the
# runtime stage, so it doesn't bloat the final image.
RUN pip3 install --no-cache-dir boto3
COPY download_model.py ./download_model.py
RUN python3 download_model.py \
        --bucket "${MODEL_BUCKET}" \
        --model "${MODEL_NAME}" \
        --version "${MODEL_VERSION}" \
        --dest /build/model-weights

# OPTIMIZATION: requirements copied (and installed) AFTER weights but
# BEFORE application code. This layer is cached and only rebuilds when
# M1_requirements.txt changes - not on every source edit, and not when
# MODEL_VERSION is bumped.
COPY M1_requirements.txt ./requirements.txt
RUN pip3 install --no-cache-dir --target=/build/deps -r requirements.txt

# ==========================
# STAGE 2: runtime - minimal CUDA runtime, no compilers, non-root
# ==========================
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04 AS runtime

# Values the CI pipeline already passes via `docker build --build-arg ...`
# (see the `build-args:` block in M1_github_workflow.yml).
ARG MODEL_NAME
ARG MODEL_VERSION
ARG BUILD_DATE

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/deps \
    MODEL_WEIGHTS_DIR=/app/models \
    MODEL_NAME=${MODEL_NAME} \
    MODEL_VERSION=${MODEL_VERSION} \
    PORT=8000

LABEL org.opencontainers.image.title="techcorp-llm-api" \
      org.opencontainers.image.version="${MODEL_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"

# Install only runtime Python (no dev tools, no build-essential)
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3-distutils \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3.10 /usr/bin/python

# SECURITY: create a non-root user for the final image
RUN groupadd -r appgroup && useradd -r -g appgroup -d /app appuser

WORKDIR /app

# Dependencies only - no compilers, no pip cache, no build context
COPY --from=builder /build/deps /app/deps

# Model weights (or, until real credentials/weights exist, the placeholder
# - see download_model.py) from the builder's cached download layer. Same
# "rare change" tier as dependencies, so this sits above the app-code copy
# below, not below it.
COPY --from=builder /build/model-weights /app/models

# OPTIMIZATION: application code copied LAST - it changes far more often
# than dependencies or model weights, so editing it doesn't invalidate the
# (expensive) layers above.
COPY M1_app.py ./M1_app.py

RUN chown -R appuser:appgroup /app

# SECURITY: switch to the non-root user
USER appuser

EXPOSE 8000

# Container-level health check against the /health endpoint in M1_app.py,
# so Docker/Kubernetes can detect and replace a stuck container.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health', timeout=3).status == 200 else 1)"

# --timeout-graceful-shutdown gives in-flight requests up to 30s to finish
# on SIGTERM instead of killing them immediately (paired with the lifespan
# shutdown hook in M1_app.py that flips readiness off first).
CMD ["python", "-m", "uvicorn", "M1_app:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "30"]

# =============================================================================
# BUILD / VERIFY:
#   docker build -t techcorp-llm:v1 \
#       --build-arg MODEL_NAME=llama-3.1-8b \
#       --build-arg MODEL_VERSION=v1.0.0 \
#       --build-arg MODEL_BUCKET=techcorp-llm-models \
#       --build-arg BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) .
#   docker images techcorp-llm:v1          # check size
#   docker run -p 8000:8000 techcorp-llm:v1
#   curl http://localhost:8000/health
#
# Re-running the build after only editing M1_app.py should show CACHED for
# both the "download_model.py" and "pip3 install -r requirements.txt"
# steps - that's the point of this layer ordering.
# =============================================================================
